import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.*;
import javafx.scene.paint.Color;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.stage.Stage;

public class SDGPoster extends Application {

    @Override
    public void start(Stage stage) {

        // Main layout
        VBox root = new VBox(15);
        root.setAlignment(Pos.CENTER);
        root.setPadding(new Insets(25));
        root.setStyle("-fx-background-color: #E8F5E9;");

        // Title
        Label title = new Label("SDG 13 - CLIMATE ACTION");
        title.setFont(Font.font("Arial",
                FontWeight.BOLD, 28));
        title.setTextFill(Color.DARKGREEN);

        // Subtitle
        Label subtitle = new Label(
                "SAVE EARTH - SAVE FUTURE");
        subtitle.setFont(Font.font("Arial",
                FontWeight.BOLD, 20));

        // Main message
        Label message = new Label(
                "THERE IS NO PLANET B!");
        message.setFont(Font.font("Arial",
                FontWeight.BOLD, 25));
        message.setTextFill(Color.FORESTGREEN);

        Label description = new Label(
                "Take action today for a sustainable tomorrow.");
        description.setFont(Font.font(16));

        // Awareness points
        Label points = new Label(
                "🌳 Plant Trees\n\n" +
                "♻ Recycle Waste\n\n" +
                "💧 Save Water\n\n" +
                "⚡ Save Energy");

        points.setFont(Font.font("Arial", 18));
        points.setTextFill(Color.DARKGREEN);

        // Action button
        Button button = new Button("TAKE A PLEDGE");
        button.setFont(Font.font(16));
        button.setStyle(
                "-fx-background-color: #2E7D32;" +
                "-fx-text-fill: white;" +
                "-fx-font-weight: bold;" +
                "-fx-padding: 12 25 12 25;"
        );

        // Button action
        Label result = new Label("");

        button.setOnAction(e ->
                result.setText(
                    "Thank you! Be the change! 🌱"
                )
        );

        // Footer
        Label footer = new Label(
                "SMALL ACTIONS CREATE A BIG DIFFERENCE"
        );
        footer.setFont(Font.font("Arial",
                FontWeight.BOLD, 14));
        footer.setTextFill(Color.DARKGREEN);

        // Add controls to layout
        root.getChildren().addAll(
                title,
                subtitle,
                new Separator(),
                message,
                description,
                points,
                button,
                result,
                footer
        );

        // Create scene
        Scene scene = new Scene(root, 600, 650);

        stage.setTitle("SDG 13 - Climate Action Poster");
        stage.setScene(scene);
        stage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
